# Public GitHub Pages defaults. These values are public; never add secrets.
# Omit VITE_SITE_URL for the Pages default; explicit blank omits absolute SEO URLs.
# RepoRun Docker supplies VITE_BASE_PATH=/ and blank VITE_SITE_URL until assigned.
VITE_SITE_URL=https://mtomashevski.github.io
VITE_BASE_PATH=/lumora-company-website/
# Optional public inquiry endpoint. Never place an API key or secret here.
VITE_INQUIRY_ENDPOINT=
