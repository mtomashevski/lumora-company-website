# Public GitHub Pages build defaults; override for another host. No secrets belong here.
VITE_SITE_URL=
VITE_BASE_PATH=
# Optional public inquiry endpoint. Never place an API key or secret here.
VITE_INQUIRY_ENDPOINT=

# V2 planning reference ONLY. V2 reads its own v2/.env.local at build/dev time;
# runtime secrets must be configured in the server host environment.
# APP_ENV: development | staging | production. Never infer this from NODE_ENV.
APP_ENV=
# Absolute origin; HTTPS and an explicit origin are required remotely.
SITE_ORIGIN=
# Public identifiers (Sanity published reads; Supabase Auth; PayPal JS SDK).
# They are NOT automatically exported to the browser. Use an allowlisted DTO.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
# SERVER ONLY: never rename these to VITE_* or serialize them from loaders.
SANITY_READ_TOKEN=
SANITY_PREVIEW_TOKEN=
SANITY_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SESSION_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
LUMORA_NOTIFICATION_EMAIL=
# No service is integrated or enabled in Phase 1. No credentials needed yet.
