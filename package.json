{
  "name": "lumora-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/generate-seo.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:pages": "node --experimental-strip-types scripts/serve-pages.mjs",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src vite.config.ts index.html",
    "test": "playwright test",
    "dev:v2": "cd v2 && react-router dev",
    "typecheck:v2": "cd v2 && react-router typegen && tsc -p tsconfig.json",
    "build:v2": "cd v2 && react-router build",
    "serve:v2": "cd v2 && react-router-serve build/server/index.js",
    "build:v2:vercel": "node scripts/build-v2-vercel.mjs",
    "test:v2:unit": "node --experimental-strip-types --test tests/v2/config.test.ts",
    "test:v2": "playwright test --config playwright.v2.config.ts",
    "test:v2:dev": "node scripts/test-v2-dev.mjs",
    "check:v2:boundaries": "node scripts/check-v2-boundaries.mjs"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "isbot": "5.2.2",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.18.4",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/react-router": "1.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
